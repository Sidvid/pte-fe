{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@admin/*": [
        "src/modules/admin/*"
      ],
      "@students/*": [
        "src/modules/students/*"
      ],
      "@common/*": [
        "src/common/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}